{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:secret_input",
  "title": "A secret to seal",
  "description": "What secrets.put takes: the value to seal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value"
  ],
  "properties": {
    "value": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "value": "ghp_0123456789abcdef"
    }
  ]
}
