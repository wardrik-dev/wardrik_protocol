{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:server_input",
  "title": "A server to add",
  "description": "What mcp_servers.add takes: the server's name, its URL, how the owner's agents sign in to it, and which of its tools they take.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "url",
    "auth"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "What the owner's agents call it: their definitions name its tools as name/*, and each tool arrives as name__tool. Letters, digits, - and _, up to 32, never __."
    },
    "url": {
      "type": "string",
      "description": "The server's whole URL, over https, reached as Streamable HTTP."
    },
    "auth": {
      "description": "How the owner's agents sign in to it.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "none"
          ],
          "properties": {
            "none": {
              "type": "object",
              "additionalProperties": false,
              "description": "It takes no credential."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oauth"
          ],
          "properties": {
            "oauth": {
              "type": "object",
              "additionalProperties": false,
              "description": "The owner signs in in a browser, and the token is kept for them. Left bare, the server's own authorization server is found from its URL, and Wardrik becomes its client itself. Where it can't be, as with a service that publishes no metadata or registers no clients, name an OAuth app the owner can use as provider, or give the app they registered there: its issuer or its endpoints, its client_id, and the name of the secret they keep its client secret under.",
              "properties": {
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The scopes to ask for, the server's own unless it says."
                },
                "issuer": {
                  "type": "string",
                  "description": "The authorization server's issuer URL, whose metadata names its endpoints."
                },
                "authorization_endpoint": {
                  "type": "string",
                  "description": "Where a person signs in, where the issuer publishes no metadata. Given with token_endpoint."
                },
                "token_endpoint": {
                  "type": "string",
                  "description": "Where a code is exchanged for a token. Given with authorization_endpoint."
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The owner's OAuth app's client ID."
                },
                "client_secret": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "description": "The app's client secret, as a secret the owner keeps in the vault. It is sealed apart from the owner's secrets as the server is added, so it is never sent anywhere but the token endpoint.",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The secret's name in the owner's vault."
                    }
                  }
                },
                "client_auth": {
                  "type": "string",
                  "enum": [
                    "post",
                    "basic"
                  ],
                  "description": "How the client secret is sent: in the form, or as HTTP Basic. post unless it says."
                },
                "authorization_params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "propertyNames": {
                    "not": {
                      "enum": [
                        "response_type",
                        "client_id",
                        "redirect_uri",
                        "scope",
                        "state",
                        "code_challenge",
                        "code_challenge_method",
                        "resource"
                      ]
                    }
                  },
                  "description": "Extra parameters for a browser sign-in, as access_type: offline. Can't set the ones Wardrik sends itself."
                },
                "provider": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
                  "description": "An OAuth app to sign in with, by name: the owner's, their org's or the deployment's. Takes the place of an app given here."
                }
              },
              "dependentRequired": {
                "client_secret": [
                  "client_id"
                ],
                "client_auth": [
                  "client_secret"
                ],
                "authorization_endpoint": [
                  "token_endpoint"
                ],
                "token_endpoint": [
                  "authorization_endpoint"
                ]
              },
              "dependentSchemas": {
                "provider": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "scopes"
                        ]
                      },
                      {
                        "required": [
                          "issuer"
                        ]
                      },
                      {
                        "required": [
                          "authorization_endpoint"
                        ]
                      },
                      {
                        "required": [
                          "token_endpoint"
                        ]
                      },
                      {
                        "required": [
                          "client_id"
                        ]
                      },
                      {
                        "required": [
                          "client_secret"
                        ]
                      },
                      {
                        "required": [
                          "client_auth"
                        ]
                      },
                      {
                        "required": [
                          "authorization_params"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "description": "A key the owner keeps in the vault, sent with every call.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The secret's name in the owner's vault."
                },
                "header": {
                  "type": "string",
                  "description": "The header it is sent in; authorization unless it says."
                },
                "scheme": {
                  "type": "string",
                  "description": "What comes before it in the header; Bearer unless it says, and nothing where it is empty."
                }
              }
            }
          }
        }
      ]
    },
    "only": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The server's own names of the tools to take, every one unless it says."
    },
    "except": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The server's own names of the tools to leave."
    }
  },
  "examples": [
    {
      "name": "social",
      "url": "https://mcp.social.example/mcp",
      "auth": {
        "oauth": {
          "scopes": [
            "write"
          ]
        }
      }
    },
    {
      "name": "crm",
      "url": "https://mcp.crm.example/mcp",
      "auth": {
        "secret": {
          "name": "crm-key"
        }
      }
    },
    {
      "name": "docs",
      "url": "https://docs.example.com/mcp",
      "auth": {
        "none": {}
      },
      "only": [
        "search"
      ]
    },
    {
      "name": "github",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": {
        "oauth": {
          "issuer": "https://github.com/login/oauth",
          "client_id": "Iv1.8a61f9b3a7aba766",
          "client_secret": {
            "name": "GITHUB_APP_SECRET"
          },
          "scopes": [
            "repo"
          ]
        }
      }
    },
    {
      "name": "ads",
      "url": "https://mcp.ads.example/mcp",
      "auth": {
        "oauth": {
          "provider": "google"
        }
      }
    }
  ]
}
