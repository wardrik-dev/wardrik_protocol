{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:connections",
  "title": "Connections",
  "description": "What connections.list answers: the accounts an owner is offered, and whether they hold each. A value is never answered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connections"
  ],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "$ref": "urn:wardrik:schema:v1:connection"
      }
    }
  },
  "examples": [
    {
      "connections": [
        {
          "provider": "github",
          "connected": true
        },
        {
          "provider": "linear",
          "connected": false
        }
      ]
    }
  ]
}
