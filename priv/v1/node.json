{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:node",
  "title": "A node",
  "description": "What agent.move takes: the node to start the agent again on, by its name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "type": "string",
      "description": "A node's name, as wardrik@box1."
    }
  },
  "examples": [
    {
      "node": "wardrik@box2"
    }
  ]
}
