{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:ceilings",
  "title": "Ceilings",
  "description": "What ceilings.list answers: each of an org's ceilings, budgets its agents spend from together, with what they've spent against it in its period now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ceilings"
  ],
  "properties": {
    "ceilings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ceiling",
          "per",
          "on_exhausted",
          "limit",
          "spent",
          "granted"
        ],
        "properties": {
          "ceiling": {
            "type": "string",
            "description": "The ceiling's name."
          },
          "per": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "total"
            ],
            "description": "How long its limit lasts before it starts over."
          },
          "on_exhausted": {
            "type": "string",
            "enum": [
              "ask",
              "deny",
              "continue"
            ],
            "description": "What the org's next model call does once they've spent it: waits on a ceiling_approval, is refused, or runs."
          },
          "limit": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/amount"
          },
          "spent": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/amount"
          },
          "granted": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/amount"
          },
          "starts_over": {
            "type": "string",
            "format": "date",
            "description": "The day it starts over, in its timezone. Absent for a ceiling in total."
          }
        }
      }
    }
  },
  "examples": [
    {
      "ceilings": [
        {
          "ceiling": "plan",
          "per": "month",
          "on_exhausted": "ask",
          "limit": {
            "usd": 20.0
          },
          "spent": {
            "usd": 12.4,
            "tokens": 81200
          },
          "granted": {},
          "starts_over": "2026-11-01"
        }
      ]
    }
  ]
}
